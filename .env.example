# Harmonix — environment configuration
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.

# Public base URL of the app (used for OAuth redirect). In dev this is localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Spotify Web API credentials — https://developer.spotify.com/dashboard
# Create an app, add redirect URI: http://localhost:3000/api/auth/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 key — https://console.cloud.google.com (enable YouTube Data API v3)
YOUTUBE_API_KEY=
