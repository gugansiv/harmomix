# Harmonix — environment configuration
# Copy this file to .env.local and fill in real values. NEVER commit .env.local.
# NEVER put real secrets in this file — it is committed to the repo.

# Public base URL of the app (fallback for OAuth landing). In dev this is localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Spotify Web API credentials — https://developer.spotify.com/dashboard
# Create an app, and add this EXACT Redirect URI in the dashboard:
#   http://localhost:3000/api/auth/spotify/callback
# (scheme + host + path, no trailing slash). Reuse it below for SPOTIFY_REDIRECT_URI.
# NOTE: Client ID is public; Client Secret is SECRET — keep it only in .env.local.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Authoritative Spotify OAuth redirect URI. Set this to the value registered in
# the Spotify dashboard. If unset, the app derives it from the request host.
# MUST equal one of the dashboard's registered Redirect URIs or Spotify returns
# spotify_error=state_mismatch.
SPOTIFY_REDIRECT_URI=http://localhost:3000/api/auth/spotify/callback

# YouTube Data API v3 key — https://console.cloud.google.com (enable YouTube Data API v3)
YOUTUBE_API_KEY=
